---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Brilho no Viver', description = 'Protótipo do site Brilho no Viver' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
